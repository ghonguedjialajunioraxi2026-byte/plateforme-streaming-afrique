{
  "title": "FLICK — API",
  "uid": "flick-api",
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Backend UP",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [{ "expr": "up{job=\"flick-backend\"}", "refId": "A" }],
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "Requêtes /s (5 min)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count[5m])) by (status)", "refId": "A" }
      ],
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 0 }
    },
    {
      "id": 3,
      "title": "Latence p50 / p95 (s)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket[5m])) by (le))", "refId": "A", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le))", "refId": "B", "legendFormat": "p95" }
      ],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 }
    },
    {
      "id": 4,
      "title": "Mémoire JVM utilisée (octets)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "sum(jvm_memory_used_bytes{job=\"flick-backend\"}) by (area)", "refId": "A" }
      ],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 }
    }
  ]
}
