# URL de base de l'API backend (sans le préfixe /api, ajouté par http.ts).
# Dev local : Spring Boot sur :8080. Prod : domaine de l'API.
VITE_API_URL=http://localhost:8080/api

# Client ID OAuth Google PUBLIC (console Google Cloud : Identifiants).
# Pas un secret : visible dans le HTML et la console Google. Doit être le
# MÊME que GOOGLE_CLIENT_ID côté backend (audience attendue de l'id_token).
# Valeur par défaut = Client ID FLICK (fonctionnel tel quel).
VITE_GOOGLE_CLIENT_ID=465175507754-hli0c7t5d876elogv4h2a1t0c5dm0vld.apps.googleusercontent.com

# URL publique du site (canonical + Open Graph, étape 25).
# Placeholder à remplacer au déploiement (jamais un secret).
# VITE_SITE_URL=https://app.flick.example
