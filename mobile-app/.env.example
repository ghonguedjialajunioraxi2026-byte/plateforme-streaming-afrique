# FLICK mobile — configuration par --dart-define (JAMAIS de secret ici).
#
# Exemples :
#   # Émulateur Android (localhost de la machine hôte) :
#   flutter run --dart-define=API_BASE_URL=http://10.0.2.2:8080/api
#
#   # Appareil physique sur le même Wi-Fi (IP LAN du PC) :
#   flutter run --dart-define=API_BASE_URL=http://192.168.1.20:8080/api --dart-define=HLS_BASE_URL=http://192.168.1.20:18080
#
#   # Production :
#   flutter build apk --dart-define=FLICK_ENV=prod --dart-define=API_BASE_URL=https://api.flick.example.com/api
#
# API_BASE_URL=http://10.0.2.2:8080/api
# HLS_BASE_URL=http://10.0.2.2:18080
# PUBLIC_SITE_URL=https://flick.example.com
# FLICK_ENV=dev
# Client ID OAuth Google WEB (public, = GOOGLE_CLIENT_ID backend).
# Vide = bouton Google désactivé. Voir README, section Google.
# GOOGLE_SERVER_CLIENT_ID=xxx.apps.googleusercontent.com
