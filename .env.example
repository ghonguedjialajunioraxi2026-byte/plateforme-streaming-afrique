# ============================================================
# Flick — variables d'environnement (MODÈLE, sans vraie valeur)
# Copier vers .env et renseigner. NE JAMAIS commiter de secret.
# ============================================================

# --- Base de données ---
# DATABASE_URL=jdbc:postgresql://localhost:5432/flick
# DB_USER=flick
# DB_PASSWORD=change-moi

# --- Redis ---
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_SSL=false

# --- JWT (étape 08) : OBLIGATOIRE en production ---
# JWT_SECRET=au-moins-32-caracteres-aleatoires
# JWT_ACCESS_TOKEN_TTL=15m
# JWT_REFRESH_TOKEN_TTL=7d

# --- CORS / Frontend ---
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Intelligence artificielle (étape 18) ---
# stub = local, déterministe, 0 coût (défaut)
# http = OpenAI-compatible (OpenAI, Ollama…​) — clé JAMAIS dans le frontend
# AI_ENABLED=true
# AI_PROVIDER=stub
# AI_MODEL=flick-stub-1
# AI_BASE_URL=
# AI_API_KEY=
# AI_TIMEOUT=20s
# AI_MAX_PROMPT_CHARS=2000
# AI_MAX_OUTPUT_TOKENS=500
# AI_DAILY_QUOTA_USER=30
# AI_DAILY_QUOTA_CREATOR=100
# AI_DAILY_QUOTA_STAFF=300
# AI_RATE_LIMIT_CREATOR_PER_MINUTE=10
# AI_RATE_LIMIT_USER_PER_MINUTE=10
# AI_CACHE_TTL=30m

# --- Paiements (étape 14) ---
# PAYMENTS_SANDBOX_ENABLED=true
# PAYMENT_WEBHOOK_SECRET=

# --- Streaming (étape 10) ---
# RTMP_INGEST_URL=rtmp://localhost:1935/live
# HLS_BASE_URL=http://localhost:18080
# INGEST_CALLBACK_SECRET=change-moi
