# ============================================================
# Streaming Afrique — variables d'environnement LOCALES
#
# Usage :
#   cp .env.example .env        # copier puis remplir
#   # .env est git-ignoré (jamais commité) — voir .gitignore
#   docker compose up -d --build
#
# Règle d'or (permanente) : AUCUN secret n'est commité dans Git.
# Les secrets vivent uniquement dans l'environnement local (.env)
# ou, en production, dans l'environnement du serveur (systemd,
# Docker -e, secrets manager). Les valeurs ci-dessous marquées
# "dev-only" sont FAIBLES et INUTILISABLES en production.
#
# Générer une clé JWT forte (≥ 32 octets) :
#   openssl rand -base64 48
# ============================================================

# ---------- Base de données PostgreSQL ----------
# Hôte/port/nom/utilisateur (défauts = local docker-compose)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=streaming_afrique
DB_USERNAME=streaming
# Mot de passe OBLIGATOIRE même en dev (aucun défaut en application-dev.yml)
# Défaut docker-compose : dev-only-changeme (faible, local uniquement)
DB_PASSWORD=

# ---------- Redis (cache, présence, rate-limiting) ----------
REDIS_HOST=localhost
REDIS_PORT=6379
# Mot de passe vide en dev (Redis local sans AUTH) ; en prod OBLIGATOIRE
REDIS_PASSWORD=
# TLS Redis : false en dev, true en prod (Redis Cloud / ElastiCache)
REDIS_SSL=false
# Préfixe des clés applicatives (namespace) et TTL par défaut
REDIS_PREFIX=sa
REDIS_DEFAULT_TTL=10m

# ---------- JWT (authentification) ----------
# Clé HMAC-SHA256 ≥ 32 caractères. En dev : optionnelle (clé éphémère + warning sinon)
# En prod : OBLIGATOIRE (démarrage refusé si absente)
# Défaut docker-compose dev : dev-jwt-cle-locale-32-octets-minimum-ok
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d
JWT_ISSUER=streaming-afrique-backend

# ---------- Google (connexion "Continuer avec Google") ----------
# Client ID OAuth PUBLIC du projet Google Cloud (console : Identifiants).
# PAS de secret ici : le flux ID token n'utilise AUCUN Client Secret et
# AUCUN redirect_uri backend (vérification signature/audience/expiration).
# Vide = connexion Google désactivée (503 explicite, login classique intact).
# Le même ID est exposé au frontend via VITE_GOOGLE_CLIENT_ID (public aussi).
# Défaut = Client ID FLICK (fonctionnel tel quel).
GOOGLE_CLIENT_ID=465175507754-hli0c7t5d876elogv4h2a1t0c5dm0vld.apps.googleusercontent.com

# ---------- Frontend (liens email : vérification, récupération) ----------
# URL publique du frontend, préfixe des liens envoyés par email.
FRONTEND_URL=http://localhost:5173

# ---------- Email (SMTP futur, NON configuré à l'étape 08) ----------
# En dev/test : expéditeur console (liens rejoués dans les logs, jamais en prod).
# En prod : aucun envoi tant que le SMTP n'est pas branché (étape dédiée).
# Les tokens ne sont JAMAIS journalisés en production (NoOpMailService).
MAIL_ENABLED=false
MAIL_FROM=no-reply@streaming-afrique.com
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------- CORS / WebSocket ----------
# Origines autorisées (liste séparée par virgules, sans espace superflu)
# Dev : Vite local (http://localhost:5173)
# Prod : domaine officiel (ex. https://app.streaming-afrique.com)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# WS suit CORS par défaut ; définir seulement pour diverger en prod
# WS_ALLOWED_ORIGINS=https://app.streaming-afrique.com

# ---------- Paiements (étape 14 : argent réel → coins) ----------
# Secret HMAC-SHA256 des signatures webhook (en-tête X-Webhook-Signature).
# En dev : défaut local faible via application-dev.yml (surchargable ici).
# En prod : OBLIGATOIRE (PAYMENT_WEBHOOK_SECRET) — sans lui, TOUT webhook
# est rejeté et aucun wallet n'est crédité. Générer avec :
#   openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=
# Sandbox : true = prestataires simulés (dev/test) ; prod = false + câblage réel.
PAYMENTS_SANDBOX_ENABLED=true
# Âge maximal d'un paiement non confirmé avant EXPIRED (jamais crédité).
PAYMENTS_EXPIRY_AFTER=30m

# ---------- Vidéos VOD + clips (étape 15) ----------
# Taille maximale d'UNE vidéo téléversée (Mo) — types MP4/WebM vérifiés
# sur le contenu (jamais l'extension). Durées d'extrait (secondes).
VIDEO_MAX_UPLOAD_MB=512
CLIP_MIN_DURATION=3
CLIP_MAX_DURATION=60
# FFmpeg : false en dev (binaire absent) ; passer à true + binaire installé
# pour la durée réelle, les miniatures auto et la découpe serveur.
VIDEO_FFMPEG_ENABLED=false
# Rejeu au boot des traitements orphelins (crash/redéploiement).
VIDEO_RECOVERY_ENABLED=true

# ---------- Stockage fichiers ----------
# Dossier racine des uploads (dev : ./uploads ; prod : volume persistant ex. /app/uploads)
STORAGE_LOCATION=./uploads

# ---------- Profil Spring ----------
# Dev : dev  |  Prod : prod  |  Tests : aucun (H2 en mémoire, profil "default")
SPRING_PROFILES_ACTIVE=dev
